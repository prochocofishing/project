{
  "name": "angular-starter",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run generate-sitemap && ng build",
    "build:prod": "npm run generate-sitemap && ng build --configuration production",
    "deploy": "npm run build:static && npx angular-cli-ghpages --dir=dist/static",
    "prerender": "node prerender.js",
    "prerender:install-browsers": "npx playwright install --with-deps chromium",
    "build:static": "npm run build:prod && npm run prerender",
    "deploy:prerender": "node scripts/deploy-prerender.js",
    "generate-sitemap": "node generate-sitemap.js",
    "preview": "node scripts/static-server.js dist/static",
    "preview:app": "node scripts/static-server.js dist/prochoco --app",
    "test:static": "node scripts/validate-static.js",
    "verify:site": "node scripts/verify-site.cjs",
    "optimize:images": "node scripts/optimize-images.cjs"
  },
  "dependencies": {
    "@angular/animations": "^20.3.34",
    "@angular/common": "^20.3.34",
    "@angular/compiler": "^20.3.34",
    "@angular/core": "^20.3.34",
    "@angular/forms": "^20.3.34",
    "@angular/platform-browser": "^20.3.34",
    "@angular/router": "^20.3.34",
    "rxjs": "^7.8.1",
    "tslib": "^2.5.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.42",
    "@angular/cli": "^20.3.42",
    "@angular/compiler-cli": "^20.3.34",
    "lighthouse": "^12.8.2",
    "playwright": "^1.35.0",
    "sharp": "^0.35.5",
    "typescript": "^5.8.2"
  }
}
